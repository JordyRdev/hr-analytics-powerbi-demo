    ROW ( "n", 16, "kpi", "Expatriates", "filter", "none", "date", "2026-10-31", "expected", 187.0, "tol", 0.0, "value", CALCULATE ( [Expatriates], 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
