    ROW ( "n", 42, "kpi", "DQ Issues: Missing nationality", "filter", "none", "date", "2026-10-31", "expected", 18.0, "tol", 0.0, "value", CALCULATE ( [DQ Issues], DQ_Issues[Check] = "Missing nationality" ) ),
