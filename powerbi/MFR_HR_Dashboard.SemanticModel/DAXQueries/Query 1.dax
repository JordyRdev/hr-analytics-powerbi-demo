    ROW ( "n", 39, "kpi", "DQ Issues: Contract end before start", "filter", "none", "date", "2026-10-31", "expected", 11.0, "tol", 0.0, "value", CALCULATE ( [DQ Issues], DQ_Issues[Check] = "Contract end before start" ) ),
