    ROW ( "n", 45, "kpi", "DQ Issues: Legacy vacancy not migrated", "filter", "none", "date", "2026-10-31", "expected", 6.0, "tol", 0.0, "value", CALCULATE ( [DQ Issues], DQ_Issues[Check] = "Legacy vacancy not migrated" ) ),
    ROW ( "n", 46, "kpi", "DQ Issues: Country spelling variant", "filter", "none", "date", "2026-10-31", "expected", 2754.0, "tol", 0.0, "value", CALCULATE ( [DQ Issues], DQ_Issues[Check] = "Country spelling variant" ) )
        )
EVALUATE
    ADDCOLUMNS (
        _all,
        "diff", [value] - [expected],
        "ok", NOT ISBLANK ( [value] ) && ABS ( [value] - [expected] ) <= [tol]
    )
ORDER BY [n]
