-- All validation rows in one result. Column ok is TRUE when value is within tolerance of expected.
DEFINE
    VAR _all =
        UNION (
    ROW ( "n", 1, "kpi", "Headcount", "filter", "none", "date", "2026-10-31", "expected", 989.0, "tol", 0.0, "value", CALCULATE ( [Headcount], 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
    ROW ( "n", 2, "kpi", "Headcount", "filter", "Population=National", "date", "2026-10-31", "expected", 743.0, "tol", 0.0, "value", CALCULATE ( [Headcount], DimPopulation[Population] = "National", 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
    ROW ( "n", 3, "kpi", "Headcount", "filter", "Population=International", "date", "2026-10-31", "expected", 173.0, "tol", 0.0, "value", CALCULATE ( [Headcount], DimPopulation[Population] = "International", 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
    ROW ( "n", 4, "kpi", "Headcount", "filter", "Population=Global", "date", "2026-10-31", "expected", 73.0, "tol", 0.0, "value", CALCULATE ( [Headcount], DimPopulation[Population] = "Global", 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
    ROW ( "n", 5, "kpi", "Headcount", "filter", "Population Detail=Global - HQ", "date", "2026-10-31", "expected", 50.0, "tol", 0.0, "value", CALCULATE ( [Headcount], DimPopulation[Population Detail] = "Global - HQ", 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
