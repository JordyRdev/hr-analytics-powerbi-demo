    ROW ( "n", 31, "kpi", "Appraisal Completion", "filter", "none", "date", "2026-10-31", "expected", 0.791111, "tol", 0.0001, "value", CALCULATE ( [Appraisal Completion], 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
    ROW ( "n", 32, "kpi", "Avg Current Contract Duration G3/G4 (months)", "filter", "none", "date", "2026-10-31", "expected", 16.359649, "tol", 0.01, "value", CALCULATE ( [Avg Current Contract Duration G3/G4 (months)], 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
    ROW ( "n", 33, "kpi", "Avg Granted Duration New Joiners G3/G4 (months)", "filter", "none", "date", "2026-10-31", "expected", 11.714286, "tol", 0.01, "value", CALCULATE ( [Avg Granted Duration New Joiners G3/G4 (months)], 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) ),
