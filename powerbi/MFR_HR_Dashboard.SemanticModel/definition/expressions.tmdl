expression Stg_JiraVacancies =
		let
		    v = Table.SelectRows(Stg_Jira, each [issue_type] = "Vacancy"),
		    histOpened = Record.FromList(Table.Column(Stg_HistVacancies, "opened"), Table.Column(Stg_HistVacancies, "vacancy_id")),
		    a = Table.AddColumn(v, "closed_status", each List.Contains({"Done", "Cancelled"}, [status]), type logical),
		    b = Table.AddColumn(a, "date_issue", each [closed_status] and [resolved] <> null and [created] <> null and [resolved] < [created], type logical),
		    c = Table.AddColumn(b, "closed", each if [date_issue] then [created] else if [closed_status] then [resolved] else null, type nullable date),
		    d = Table.AddColumn(c, "opened", each if [legacy_vacancy_ref] = null then [created] else Record.FieldOrDefault(histOpened, [legacy_vacancy_ref], [created]), type nullable date),
		    e = Table.AddColumn(d, "outcome", each if [closed] = null then null else [closure_outcome], type text),
		    f = Table.AddColumn(e, "candidate", each if [closed] = null then null else [candidate_type], type text),
		    g = Table.AddColumn(f, "reopened", each [reopened_count] > 0, type logical),
		    h = Table.AddColumn(g, "source", each if [legacy_vacancy_ref] <> null then "JIRA (migrated)" else "JIRA", type text),
		    sel = Table.SelectColumns(h, {"issue_key", "country", "country_raw", "grade", "opening_reason", "opened", "planned_start_date",
		        "planned_duration_months", "closed", "outcome", "candidate", "time_to_done_hours", "date_issue", "reopened", "source", "legacy_vacancy_ref"}),
		    renamed = Table.RenameColumns(sel, {{"issue_key", "vacancy_id"}, {"planned_start_date", "planned_start"},
		        {"planned_duration_months", "planned_months"}, {"candidate", "candidate_type"}})
		in
		    renamed
	lineageTag: 0f54c709-dcc3-5b01-98b2-3aad60b47a5c

