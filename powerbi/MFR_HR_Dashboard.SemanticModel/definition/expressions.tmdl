expression Stg_CurrentSpans =
		let
		    coreStaff = Table.SelectColumns(Stg_CoreStaff, {"staff_id", "date_of_birth", "gender", "nationality", "start_date"}),
		    joined = Table.NestedJoin(Stg_CoreContracts, {"staff_id"}, coreStaff, {"staff_id"}, "s", JoinKind.LeftOuter),
		    expanded = Table.ExpandTableColumn(joined, "s", {"date_of_birth", "gender", "nationality", "start_date"}, {"date_of_birth", "gender", "nationality", "emp_start"}),
		    coreSpans = Table.SelectColumns(Table.AddColumn(expanded, "source", each "CORE", type text),
		        {"staff_id", "start_date", "end_date_fixed", "grade", "contract_type", "country", "unit", "date_of_birth", "gender", "nationality", "emp_start", "source"}),
		    coreRenamed = Table.RenameColumns(coreSpans, {{"start_date", "span_start"}, {"end_date_fixed", "span_end"}}),
		    trackerOnly = Table.NestedJoin(Stg_TrackerStaff, {"staff_id"}, Stg_CoreStaff, {"staff_id"}, "c", JoinKind.LeftAnti),
		    trackerSpans = Table.AddColumn(Table.RemoveColumns(trackerOnly, {"c"}), "source", each "Tracker", type text),
		    trackerSel = Table.SelectColumns(trackerSpans, {"staff_id", "start_date", "end_date", "grade", "contract_type", "country", "unit", "date_of_birth", "gender", "nationality", "source"}),
		    trackerRenamed = Table.AddColumn(Table.RenameColumns(trackerSel, {{"start_date", "span_start"}, {"end_date", "span_end"}}), "emp_start", each [span_start], type nullable date),
		    combined = Table.Combine({coreRenamed, Table.SelectColumns(trackerRenamed, Table.ColumnNames(coreRenamed))})
		in
		    combined
	lineageTag: f5bd301e-81dc-5547-a0eb-f02f57cb3d5d

expression Stg_CurrentExpanded =
		let
		    withMonths = Table.AddColumn(Stg_CurrentSpans, "month_end", each
		        List.Select(CurrentMonthEnds, (m) => m >= [span_start] and ([span_end] = null or m <= [span_end]))),
		    expanded = Table.SelectRows(Table.ExpandListColumn(withMonths, "month_end"), each [month_end] <> null),
		    typed = Table.TransformColumnTypes(expanded, {{"month_end", type date}})
		in
		    typed
