expression Stg_HistSnap =
		let
		    files = Folder.Files(fx_Path("historical")),
		    sel = Table.SelectRows(files, each Text.StartsWith([Name], "Staff_Snapshots_") and Text.EndsWith([Name], ".xlsx")),
		    data = Table.AddColumn(sel, "d", each Table.PromoteHeaders(Excel.Workbook([Content], null, true){[Item = "Snapshot", Kind = "Sheet"]}[Data], [PromoteAllScalars = true])),
		    combined = Table.Combine(data[d]),
		    renamed = Table.RenameColumns(combined, {{"Snapshot Date", "month_end"}, {"Staff No", "staff_id"}, {"Sex", "gender"},
		        {"Birth Date", "dob"}, {"Nationality", "nationality"}, {"Category", "label"}, {"Grade", "grade"},
		        {"Location", "country"}, {"Unit", "unit"}, {"Contract", "contract_type"}, {"Start Date", "start_date"}}),
		    dates = Table.TransformColumns(renamed, {{"month_end", fx_ToDate, type nullable date}, {"dob", fx_ToDate, type nullable date}, {"start_date", fx_ToDate, type nullable date}}),
		    raw = Table.AddColumn(Table.AddColumn(dates, "country_raw", each [country], type text), "nationality_raw", each [nationality], type text),
		    clean = Table.TransformColumns(raw, {
		        {"country", fx_CleanCountry, type text}, {"nationality", fx_CleanCountry, type text},
		        {"gender", each Record.FieldOrDefault(Ref_GenderRecord, Text.From(_ ?? ""), "Other"), type text},
		        {"contract_type", each Record.FieldOrDefault(Ref_ContractRecord, Text.From(_ ?? ""), null), type text}})
		in
		    clean
	lineageTag: 42060d3c-9add-54f8-8da0-f0d6a9eacb01

