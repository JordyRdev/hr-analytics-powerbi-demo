expression Stg_CoreStaff =
		let
		    src = fx_Csv("core_hris", "core_staff_export.csv"),
		    typed = Table.TransformColumns(src, {
		        {"date_of_birth", fx_ToDate, type nullable date}, {"start_date", fx_ToDate, type nullable date},
		        {"end_date", fx_ToDate, type nullable date}, {"last_appraisal_date", fx_ToDate, type nullable date}}),
		    raw = Table.AddColumn(Table.AddColumn(typed, "country_raw", each [duty_country], type text), "nationality_raw", each [nationality], type text),
		    clean = Table.TransformColumns(raw, {{"duty_country", fx_CleanCountry, type text}, {"nationality", fx_CleanCountry, type text}}),
		    renamed = Table.RenameColumns(clean, {{"duty_country", "country"}, {"team", "unit"}})
		in
		    fx_Derive(renamed, "staff_category")
	lineageTag: 31bbc996-5b84-5393-99b9-8a2ae3498c9d

expression Stg_CoreContracts =
		let
		    src = fx_Csv("core_hris", "core_contracts_export.csv"),
		    typed = Table.TransformColumns(src, {
		        {"start_date", fx_ToDate, type nullable date}, {"end_date", fx_ToDate, type nullable date},
		        {"granted_months", each if _ = null then null else Number.From(_), type nullable number}}),
		    raw = Table.AddColumn(typed, "country_raw", each [duty_country], type text),
		    clean = Table.TransformColumns(raw, {{"duty_country", fx_CleanCountry, type text}}),
		    flagged = Table.AddColumn(clean, "end_before_start", each [end_date] <> null and [start_date] <> null and [end_date] < [start_date], type logical),
		    repaired = Table.AddColumn(flagged, "end_date_fixed", each
		        if [end_before_start] then
		            (if [granted_months] = null then [start_date] else Date.AddDays(Date.AddMonths([start_date], Number.Round([granted_months], 0)), -1))
		        else [end_date], type nullable date),
		    renamed = Table.RenameColumns(repaired, {{"duty_country", "country"}, {"team", "unit"}})
		in
		    renamed
	lineageTag: 278e159a-d9e6-58e1-83a4-df9407b03187

