	annotation PBI_ResultType = Date

expression fx_Path =
		(sub as text, optional file as nullable text) as text =>
		let
		    root = Text.TrimEnd(DataFolder, "\")
		in
		    root & "\" & sub & (if file = null then "" else "\" & file)
	lineageTag: 5e0adc9a-84a3-5d20-b315-b43e3fb0df87

	annotation PBI_ResultType = Function

expression fx_Sheet =
		(sub as text, file as text, sheet as text) as table =>
		let
		    wb = Excel.Workbook(File.Contents(fx_Path(sub, file)), null, true),
		    data = wb{[Item = sheet, Kind = "Sheet"]}[Data]
		in
		    Table.PromoteHeaders(data, [PromoteAllScalars = true])
	lineageTag: 437653f6-2a09-5b6b-9f5b-85fcdf70ec60

	annotation PBI_ResultType = Function

expression fx_Csv =
		(sub as text, file as text) as table =>
		let
		    src = Csv.Document(File.Contents(fx_Path(sub, file)), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    promoted = Table.PromoteHeaders(src, [PromoteAllScalars = true]),
		    blanks = Table.ReplaceValue(promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(promoted))
		in
		    blanks
	lineageTag: fa2daee2-7b82-5353-9481-e5e09c085d9a

	annotation PBI_ResultType = Function

expression fx_ToDate =
		(v as any) as nullable date =>
		let
		    out =
		        if v = null then null
		        else if v is number then Date.AddDays(#date(1899, 12, 30), Number.RoundDown(v))
		        else if v is text then
		            let t = Text.Trim(v) in
		                if t = "" then null
		                else if Text.Contains(t, "/") then try Date.FromText(t, [Format = "dd/MM/yyyy", Culture = "en-GB"]) otherwise null
		                else try Date.FromText(Text.Start(t, 10), [Format = "yyyy-MM-dd", Culture = "en-US"]) otherwise null
		        else try Date.From(v) otherwise null
		in
		    out
	lineageTag: c8443b23-2244-5920-b403-b949893e77c4

	annotation PBI_ResultType = Function

expression fx_CleanCountry =
		(value as nullable text) as nullable text =>
		let
		    t = if value = null then null else Text.Trim(value),
		    key = if t = null or t = "" then null else Text.Lower(t),
		    hit = if key = null then null else Record.FieldOrDefault(Ref_VariantRecord, key, null),
		    out = if key = null then null else if hit <> null then hit else t
		in
		    out
	lineageTag: 4102cc5c-2ce1-5523-8c11-94db0abbeee4

	annotation PBI_ResultType = Function

expression fx_Derive =
		(t as table, labelColumn as nullable text) as table =>
		let
		    withType = Table.AddColumn(t, "staff_type", each
		        let
		            fromGrade = Record.FieldOrDefault(Ref_GradeRecord, [grade] ?? "", null),
		            fromLabel = if labelColumn = null then null else Record.FieldOrDefault(Ref_LegacyRecord, Record.Field(_, labelColumn) ?? "", null)
		        in
		            if fromGrade <> null then fromGrade else fromLabel, type text),
		    withDetail = Table.AddColumn(withType, "population_detail", each
		        if [country] = HQCountry then "Global - HQ"
		        else if [staff_type] = "International" and Record.FieldOrDefault(Ref_UnitScopeRecord, [unit] ?? "", null) = "Global" then "Global - Field"
		        else if [staff_type] = "International" then "International"
		        else "National", type text)
		in
		    withDetail
	lineageTag: c54182f6-7de4-5fcd-8885-2b1f0935c6cc

	annotation PBI_ResultType = Function

expression fx_StandardiseTracker =
		(raw as table, country as nullable text) as table =>
		let
		    isHeader = (r as list) as logical =>
		        List.AnyTrue(List.Transform(r, each _ is text and Record.FieldOrDefault(Ref_AliasRecord, Text.Lower(Text.Trim(_)), null) = "staff_id")),
		    headerIndex = List.PositionOf(List.Transform(Table.ToRows(raw), isHeader), true),
		    body = Table.Skip(raw, headerIndex),
		    promoted = Table.PromoteHeaders(body, [PromoteAllScalars = true]),
		    renames = List.Transform(Table.ColumnNames(promoted), each {_, Record.FieldOrDefault(Ref_AliasRecord, Text.Lower(Text.Trim(_)), _)}),
		    renamed = Table.RenameColumns(promoted, renames, MissingField.Ignore),
		    standard = {"staff_id", "gender", "date_of_birth", "nationality", "grade", "contract_type", "team",
		                "start_date", "end_date", "exit_reason", "voluntary_exit", "last_appraisal_date"},
		    selected = Table.SelectColumns(renamed, standard, MissingField.UseNull),
		    staffOnly = Table.SelectRows(selected, each [staff_id] is text and Text.StartsWith(Text.Trim([staff_id]), "EMP-")),
		    typed = Table.TransformColumns(staffOnly, {
		        {"date_of_birth", fx_ToDate, type nullable date}, {"start_date", fx_ToDate, type nullable date},
		        {"end_date", fx_ToDate, type nullable date}, {"last_appraisal_date", fx_ToDate, type nullable date}}),
		    withCountry = Table.AddColumn(typed, "country", each country, type text)
		in
		    withCountry
	lineageTag: d8ea9052-be23-50a2-a2cf-effa9704db24

	annotation PBI_ResultType = Function

expression fx_D =
		(d as nullable date, fmt as text, optional culture as nullable text) as nullable text =>
		if d = null then null else Date.ToText(d, [Format = fmt, Culture = if culture = null then "en-US" else culture])
	lineageTag: 5109b128-cdf8-5caa-9bd7-f9d08ec676c2

	annotation PBI_ResultType = Function

expression fx_Issue =
		(t as table, check as text, severity as text, source as text, tableName as text) as table =>
		let
		    a = Table.AddColumn(t, "Check", each check, type text),
		    b = Table.AddColumn(a, "Severity", each severity, type text),
		    c = Table.AddColumn(b, "Source", each source, type text),
		    d = Table.AddColumn(c, "Table", each tableName, type text),
		    e = Table.SelectColumns(d, {"Check", "Severity", "Source", "Table", "Key", "Detail", "Record Date"})
		in
		    e
	lineageTag: 1a86a514-4d00-5762-b117-9e1fe0d77834

