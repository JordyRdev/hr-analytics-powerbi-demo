expression Stg_HistVacancies =
		let
		    t = fx_Sheet("historical", "Vacancy_Log_2022_2024.xlsx", "Vacancies"),
		    renamed = Table.RenameColumns(t, {{"Vacancy Ref", "vacancy_id"}, {"Country", "country"}, {"Grade", "grade"},
		        {"Reason", "opening_reason"}, {"Date Opened", "opened"}, {"Planned Start", "planned_start"},
