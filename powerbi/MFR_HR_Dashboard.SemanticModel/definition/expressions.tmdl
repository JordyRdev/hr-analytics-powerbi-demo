expression Stg_TrackerStaff =
		let
		    files = Folder.Files(fx_Path("country_trackers")),
		    xlsx = Table.SelectRows(files, each Text.EndsWith([Name], ".xlsx") and not Text.StartsWith([Name], "~$")),
		    withCountry = Table.AddColumn(xlsx, "country_raw", each Text.Replace(Text.Replace([Name], "NS_tracker_", ""), ".xlsx", ""), type text),
		    withData = Table.AddColumn(withCountry, "data", each fx_StandardiseTracker(Excel.Workbook([Content], null, true){0}[Data], fx_CleanCountry([country_raw]))),
		    combined = Table.Combine(withData[data]),
		    mapped = Table.TransformColumns(combined, {
		        {"gender", each Record.FieldOrDefault(Ref_GenderRecord, Text.From(_ ?? ""), "Other"), type text},
		        {"voluntary_exit", each if _ = null then null else if List.Contains({"Y", "YES", "TRUE"}, Text.Upper(Text.Trim(Text.From(_)))) then "Y" else "N", type text},
		        {"nationality", each _, type text}}),
		    nationalityRaw = Table.AddColumn(mapped, "nationality_raw", each [nationality], type text),
		    cleaned = Table.TransformColumns(nationalityRaw, {{"nationality", fx_CleanCountry, type text}}),
		    renamed = Table.RenameColumns(cleaned, {{"team", "unit"}})
		in
		    renamed
	lineageTag: 495e6f61-b107-5d3a-b81b-8ff94f676f77

