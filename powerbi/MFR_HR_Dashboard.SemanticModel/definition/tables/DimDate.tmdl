table DimDate
	lineageTag: ab339cae-f20d-5746-a9d9-8ed42f19986c
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-MM-dd
		lineageTag: e6e57fa2-9c3a-5f6d-9171-9be65a32b136
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 458cd22c-494c-5340-8a6c-be321efc8954
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: 42407633-8959-58d4-b103-1c2c83fbc751
		summarizeBy: none
		sourceColumn: Quarter

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e79d2622-0dd1-5a65-a6f4-e3fc998ff7fa
		summarizeBy: none
		sourceColumn: Month Number

	column 'Month Name'
		dataType: string
		lineageTag: aaf952d0-f389-57c5-8ad3-4485a05c3c9d
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month Number'

	column 'Month End'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 9080de23-cdb4-5431-a9d2-f8f6031e67d0
		summarizeBy: none
		sourceColumn: Month End

	column 'Year Month'
		dataType: string
		lineageTag: b02cf60f-cda7-56cc-88f0-00bae55902ea
		summarizeBy: none
		sourceColumn: Year Month

	column 'Year Quarter'
		dataType: string
		lineageTag: 8de6b1a7-f314-52e9-90db-df8265574c06
		summarizeBy: none
		sourceColumn: Year Quarter

	column 'Is Month End'
		dataType: boolean
		lineageTag: 797d5b46-1b03-5d58-b2d6-0e462d5bb306
		summarizeBy: none
		sourceColumn: Is Month End

	partition DimDate = m
		mode: import
		source =
				let
				    first = Date.StartOfMonth(HistoryStart),
				    days = List.Dates(first, Duration.Days(DataThrough - first) + 1, #duration(1, 0, 0, 0)),
				    t = Table.FromList(days, Splitter.SplitByNothing(), {"Date"}, null, ExtraValues.Error),
				    typed = Table.TransformColumnTypes(t, {{"Date", type date}}),
				    y = Table.AddColumn(typed, "Year", each Date.Year([Date]), Int64.Type),
				    q = Table.AddColumn(y, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    mn = Table.AddColumn(q, "Month Number", each Date.Month([Date]), Int64.Type),
				    mname = Table.AddColumn(mn, "Month Name", each fx_D([Date], "MMM", "en-US"), type text),
				    me = Table.AddColumn(mname, "Month End", each Date.EndOfMonth([Date]), type date),
				    ym = Table.AddColumn(me, "Year Month", each fx_D([Date], "yyyy-MM", "en-US"), type text),
				    yq = Table.AddColumn(ym, "Year Quarter", each Text.From(Date.Year([Date])) & "-Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    ime = Table.AddColumn(yq, "Is Month End", each [Date] = Date.EndOfMonth([Date]), type logical)
				in
				    ime

