	column Age
		dataType: double
		formatString: #,0.##
		lineageTag: ea02a2c1-8ec8-5f6c-93d4-f01a1d2c7620
		summarizeBy: none
		sourceColumn: Age

	column 'Is Expatriate'
		dataType: boolean
		lineageTag: 0b5495c0-018f-5733-9c5c-a49cb704d1e8
		summarizeBy: none
		sourceColumn: Is Expatriate

	partition FactStaffMonthly = m
		mode: import
		source =
			let
			    hist = Table.SelectRows(Stg_HistSnap, each [month_end] <= CutOver),
			    histSel = Table.AddColumn(Table.SelectColumns(hist, {"staff_id", "month_end", "country", "nationality", "grade", "contract_type", "gender", "dob", "unit", "start_date"}), "source", each "Historical", type text),
			    histRen = Table.RenameColumns(histSel, {{"dob", "date_of_birth"}, {"start_date", "emp_start"}}),
			    cur = Table.SelectRows(Stg_CurrentExpanded, each [month_end] > CutOver),
			    curSel = Table.SelectColumns(cur, {"staff_id", "month_end", "country", "nationality", "grade", "contract_type", "gender", "date_of_birth", "unit", "emp_start", "source"}),
			    combined = Table.Combine({Table.SelectColumns(histRen, Table.ColumnNames(curSel)), curSel}),
			    derived = fx_Derive(combined, null),
			    withAge = Table.AddColumn(derived, "Age", each if [date_of_birth] = null then null else Duration.Days([month_end] - [date_of_birth]) / 365.25, type nullable number),
			    withExpat = Table.AddColumn(withAge, "Is Expatriate", each [staff_type] = "International" and [country] <> HQCountry and [nationality] <> null and [nationality] <> [country], type logical),
			    unknownNat = Table.ReplaceValue(withExpat, null, "Unknown", Replacer.ReplaceValue, {"nationality"}),
			    renamed = Table.RenameColumns(unknownNat, {{"staff_id", "Staff ID"}, {"month_end", "Month End"}, {"source", "Source"}, {"country", "Country"},
			        {"nationality", "Nationality"}, {"grade", "Grade"}, {"contract_type", "Contract Type"}, {"gender", "Gender"},
			        {"date_of_birth", "Date of Birth"}, {"unit", "Unit"}, {"emp_start", "Start Date"}, {"population_detail", "Population Detail"}}),
			    selected = Table.SelectColumns(renamed, {"Staff ID", "Month End", "Source", "Country", "Nationality", "Grade", "Contract Type", "Gender",
			        "Date of Birth", "Unit", "Start Date", "Population Detail", "Age", "Is Expatriate"}),
			    typed = Table.TransformColumnTypes(selected, {{"Month End", type date}, {"Date of Birth", type date}, {"Start Date", type date}})
			in
			    typed
