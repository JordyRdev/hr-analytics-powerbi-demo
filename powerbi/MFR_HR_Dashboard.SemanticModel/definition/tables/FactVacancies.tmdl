	column 'Days Bucket Sort'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 7a4283b6-e32b-5727-9586-0a2afb77373a
		summarizeBy: sum
		sourceColumn: Days Bucket Sort

		annotation SummarizationSetBy = Automatic

	partition FactVacancies = m
		mode: import
		source =
				let
				    migrated = List.Buffer(List.RemoveNulls(Table.Column(Stg_JiraVacancies, "legacy_vacancy_ref"))),
				    hist = Table.SelectRows(Stg_HistVacancies, each not List.Contains(migrated, [vacancy_id])),
				    cols = {"vacancy_id", "country", "grade", "opening_reason", "opened", "planned_start", "planned_months", "closed", "outcome", "candidate_type", "time_to_done_hours", "date_issue", "reopened", "source"},
				    combined = Table.Combine({Table.SelectColumns(hist, cols), Table.SelectColumns(Stg_JiraVacancies, cols)}),
				    status = Table.AddColumn(combined, "status", each if [closed] = null then "Open" else if [outcome] = "Cancelled Position" then "Cancelled" else "Closed", type text),
				    days = Table.AddColumn(status, "days_to_close", each if [closed] <> null and [outcome] <> "Cancelled Position" and not [date_issue] then Duration.Days([closed] - [opened]) else null, type nullable number),
				    ttd = Table.AddColumn(days, "time_to_done_days", each if [days_to_close] = null or [time_to_done_hours] = null then null else [time_to_done_hours] / 24, type nullable number),
				    bucket = Table.AddColumn(ttd, "days_bucket", each
				        let d = [days_to_close] in
				            if d = null then null else if d <= 30 then "0-30" else if d <= 60 then "31-60" else if d <= 90 then "61-90"
				            else if d <= 120 then "91-120" else if d <= 180 then "121-180" else "181+", type text),
				    bucketSort = Table.AddColumn(bucket, "days_bucket_sort", each
				        let d = [days_to_close] in
				            if d = null then null else if d <= 30 then 1 else if d <= 60 then 2 else if d <= 90 then 3 else if d <= 120 then 4 else if d <= 180 then 5 else 6, Int64.Type),
				    renamed = Table.RenameColumns(bucketSort, {{"vacancy_id", "Vacancy ID"}, {"country", "Country"}, {"grade", "Grade"}, {"opening_reason", "Opening Reason"},
				        {"opened", "Opened Date"}, {"planned_start", "Planned Start Date"}, {"planned_months", "Planned Duration Months"}, {"closed", "Closed Date"},
				        {"outcome", "Closure Outcome"}, {"candidate_type", "Candidate Type"}, {"time_to_done_hours", "Time To Done Hours"}, {"date_issue", "Date Issue"},
				        {"reopened", "Reopened"}, {"source", "Source"}, {"status", "Status"}, {"days_to_close", "Days to Close"}, {"time_to_done_days", "Time To Done Days"},
				        {"days_bucket", "Days Bucket"}, {"days_bucket_sort", "Days Bucket Sort"}})
				in
				    renamed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

