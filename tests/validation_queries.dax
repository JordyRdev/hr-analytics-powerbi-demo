-- Validation queries for Part B. One query per row of expected_kpis.csv, same order.
-- Run each against the open model and compare `value` to expected_value within tolerance.

-- 01 | Headcount | none | 2026-10-31 | expected 989.0 (tol 0.0)
EVALUATE
ROW ( "kpi", "Headcount", "filter", "none", "reporting_date", DATE ( 2026, 10, 31 ),
      "value", CALCULATE ( [Headcount], 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) )

-- 02 | Headcount | Population=National | 2026-10-31 | expected 743.0 (tol 0.0)
EVALUATE
ROW ( "kpi", "Headcount", "filter", "Population=National", "reporting_date", DATE ( 2026, 10, 31 ),
      "value", CALCULATE ( [Headcount], DimPopulation[Population] = "National", 'Reporting Date'[Month End] = DATE ( 2026, 10, 31 ) ) )

